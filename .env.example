# B4 Trade-Finance Document Checker : example environment.
# Copy to .env and fill in. The onprem/test profile needs none of these.

# --- Profile (gcp | local | platform | onprem) ------------------------------ #
# 'local' is a WORKING offline stack (SQLite FTS5 over UCP600 + deterministic LLM,
# SDK-free, no API key, no emulator required) : the dev / test default. 'onprem' fails
# fast (migration placeholders); 'gcp' is the production stack.
TRADE_FINANCE_PROFILE=local

# --- Local profile stores (optional; in-package defaults under ~/.trade_finance_checker) #
# TRADE_FINANCE_LOCAL_RULES_DB=:memory:
# TRADE_FINANCE_LOCAL_AUDIT=:memory:

# --- Optional: higher-fidelity local with Google emulators (opt-in, never required) ---- #
# Set these only if you run the official emulators; the local adapters auto-detect them
# and import the google client lazily. Unset => SDK-free in-process stores (the default).
# FIRESTORE_EMULATOR_HOST=localhost:8080

# --- GCP project & residency ------------------------------------------------ #
GOOGLE_CLOUD_PROJECT=your-sg-project
TRADE_FINANCE_KMS_KEY=projects/your-sg-project/locations/asia-southeast1/keyRings/tfc/cryptoKeys/tfc

# --- Document AI (extraction) ----------------------------------------------- #
TRADE_FINANCE_DOCAI_PROCESSOR=projects/your-sg-project/locations/asia-southeast1/processors/abc123
# TRADE_FINANCE_DOCAI_VERSION=projects/your-sg-project/locations/asia-southeast1/processors/abc123/processorVersions/1

# --- DLP templates (optional; inline config is used when unset) ------------- #
# TRADE_FINANCE_DLP_INSPECT_TEMPLATE=projects/your-sg-project/locations/asia-southeast1/inspectTemplates/replace-me
# TRADE_FINANCE_DLP_DEIDENTIFY_TEMPLATE=projects/your-sg-project/locations/asia-southeast1/deidentifyTemplates/replace-me

# --- Agent Runtime (set after deploy) --------------------------------------- #
# TRADE_FINANCE_AGENT_ENGINE=projects/your-sg-project/locations/asia-southeast1/reasoningEngines/replace-me

# --- Platform service URLs (profile=platform; localhost defaults shown) ------ #
GUARDRAIL_GATEWAY_URL=http://localhost:8080      # A1 guardrail gateway
KNOWLEDGE_BASE_URL=http://localhost:8082             # A2 enterprise knowledge base (UCP600 rules)
AGENT_REGISTRY_URL=http://localhost:8083       # A3 agent registry
QUALITY_GATE_URL=http://localhost:8084        # A4 AI quality / eval gate
OBSERVABILITY_URL=http://localhost:8085  # A5 observability / audit

# --- Identity & embedding surface ------------------------------------------- #
# Secure identity is server-verified (never a client-supplied actor). In gcp/platform mode
# the app is fronted by Cloud IAP; set the audience to the IAP-protected resource so the
# injected assertion can be verified. See docs/embedding-and-identity.md.
TRADE_FINANCE_IAP_AUDIENCE=/projects/000000000000/global/backendServices/0000000000000000000
# Cross-origin / standalone CORS allowlist (comma-separated origins; NEVER "*"). Same-origin
# reverse-proxy embedding needs no CORS. Unset => local Next.js dev origins.
# TRADE_FINANCE_CORS_ORIGINS=http://localhost:3000
# CSP frame-ancestors: which parent origins may iframe the UI. Default 'self' (same-origin
# only, plus X-Frame-Options SAMEORIGIN). Set to the host origin(s) to embed cross-origin.
TRADE_FINANCE_FRAME_ANCESTORS='self'

# --- API server ------------------------------------------------------------- #
PORT=8094
# TRADE_FINANCE_API_RELOAD=false
